# Build-context excludes for the Python images (Dockerfile.python does COPY . .
# from the repo root). Without this, the local dev .venv (~1.3G), node_modules,
# .git, caches, and — critically — .env (secrets) get baked into every image.

# Secrets — must never be baked into an image (these images are published)
.env
.env.*
!.env.example

# Local virtualenv — uv rebuilds it in-image via `uv sync`
.venv

# Node / PWA — the PWA builds from its own context (pwa/Dockerfile.prod), so the
# Python images need none of it.
pwa

# VCS & CI
.git
.gitignore
.github

# Python caches
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.ruff_cache
.mypy_cache

# OS / editor cruft
.DS_Store

# Dev-only content — never read at runtime, so it has no business in a published
# image (samples alone is ~2 MB of local brochure PDFs).
samples
docs
harness
deploy
.claude
*.md
!README.md
**/tests
conftest.py
